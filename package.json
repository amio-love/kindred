{
  "name": "kindred",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev --port 8787 --persist-to .wrangler/state",
    "dev:web": "vite --port 5173",
    "dev": "bun run build:web && wrangler dev --port 8787 --persist-to .wrangler/state",
    "build:web": "vite build",
    "build": "bun run build:web && bun run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply kindred-db --local --persist-to .wrangler/state --yes",
    "db:migrate:remote": "wrangler d1 migrations apply kindred-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "deploy": "bun run build:web && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.10.0"
  }
}
